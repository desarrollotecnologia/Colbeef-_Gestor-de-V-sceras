flowchart LR
  subgraph L["Backend (RPC o REST)"]
    direction TB
    dash["getDashboardData({date}) · GET /api/dashboard<br/>meta, pendientes, antes 15:30, adicionales,<br/>incompletos, crudas, todosOPL, progresoOPL"]
    deco["prepararModuloDecomisosDesdeSIRT · generarPDFDecomisos<br/>cruce decomisos SAI × programación"]
    desp["prepararModuloDespachosDesdeSIRT · getDetallesPuesto<br/>agrupa por puesto y tipo"]
    oplcfg["getOplConfig · upsertOpl · eliminarOpl<br/>/api/opl/config"]
    crud["getCrudasDetalle · GET /api/crudas<br/>VB crudas asignadas al turno"]
    crudx["GET /api/crudas/excel<br/>?modo=general → una hoja"]
    plan["prepararPlanillaDesdeSIRT · generarPlanillaPuntos<br/>puntos por puesto / zona · plazas"]
    part["get/setOplsParticulares<br/>GET /api/planilla/excel-particulares?opls=[...]"]
    inf["getInformeDatos · generarInformeHTML<br/>beneficio · cavas · percheros"]
    hist["getHistorialPDF<br/>GET /api/historial/pdf/:id"]
    usab["/api/usability/*<br/>eventos · login · stats · export.xlsx"]
  end

  subgraph R["Elemento en pantalla (gestor.html)"]
    direction TB
    t1["Tarjeta 1: En cava · Decomisos · Crudas<br/>Adicionales · Incompletos<br/>dashSalidas · dashDecomisos · dashCrudas<br/>dashAdicionales · dashIncompletos"]
    t2["Tarjeta 2: Progreso OPL (mini)<br/>dashOplMini → modal OPL (fecha del tablero)"]
    t3["Tarjeta 3: Total juegos a despachar<br/>Antes 15:30 + Adic. = Total asignado<br/>dashDespachos · dashDespachados · dashAdicTotal · dashTotalJuegos"]
    bar["Barra Progreso de la operación<br/>progresoBarra · progresoMeta"]
    minc["Modal Incompletos<br/>juegos que salieron sin las 4 piezas"]
    ui_deco["Módulo Decomisos<br/>tabla + PDF al historial"]
    ui_desp["Módulo Despachos<br/>tabla por puesto · modal detalle"]
    ui_cfg["Modal OPL · pestaña Configuración<br/>excepciones propietario → OPL"]
    ui_crud["Módulo Crudas<br/>tabla puesto · cantidad · OPL · códigos"]
    ui_crudx["Botones Descargar Excel por OPL / general"]
    ui_plan["Módulo Planilla<br/>por puesto / por zona · PDF · plazas"]
    ui_part["Modal Particulares<br/>Excel multi-hoja de pendientes"]
    ui_inf["Módulo Informe laboral<br/>PNG"]
    ui_hist["Módulo Historial PDF<br/>filtro por fechas"]
    ui_usab["usabilidad.html"]
  end

  dash --> t1
  dash --> t2
  dash --> t3
  dash --> bar
