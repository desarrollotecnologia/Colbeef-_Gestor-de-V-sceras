POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sirt
POSTGRES_USER=acceso
# Use comillas si la clave empieza con ! u otros caracteres especiales
POSTGRES_PASSWORD="cambiar"
POSTGRES_READ_ONLY=true
POSTGRES_SSL=false
SERVER_PORT=3001
SERVER_BIND=0.0.0.0
VITE_PORT=5173

# IP de esta PC para el enlace "compartir" y consola del servidor (opcional)
LAN_SHARE_IP=192.168.20.205

# PostgreSQL: use 127.0.0.1 si la BD está en esta máquina, o la IP del servidor SIRT
# POSTGRES_HOST=192.168.x.x

# Estado_Cavas: subproductos retenidos en cava sin fecha_salida.
SIRT_CAVA_LOOKBACK_DAYS=30

# Despachos_Cavas: salidas de cava con fecha_salida.
SIRT_SALIDAS_CAVA_LOOKBACK_DAYS=30

# Decomisos (SAI): días hacia atrás desde la fecha del encabezado (automático en el programa).
SIRT_DECOMISO_LOOKBACK_DAYS=7
