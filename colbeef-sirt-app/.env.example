POSTGRES_HOST=10.64.1.47
POSTGRES_PORT=5432
POSTGRES_DB=sirt
POSTGRES_USER=acceso
# Use comillas si la clave empieza con ! u otros caracteres especiales
POSTGRES_PASSWORD="cambiar"
POSTGRES_READ_ONLY=true
POSTGRES_SSL=false
SERVER_PORT=3001
SERVER_BIND=0.0.0.0
VITE_PORT=5173

# IP de esta PC para el enlace "compartir" y consola del servidor (opcional)
LAN_SHARE_IP=192.168.20.205

# --- MySQL propio del gestor (instalar en el servidor 205) ---
# SIRT sigue en PostgreSQL. Esta BD guarda usuarios, auditoría, usabilidad y estado.
# Al arrancar el Node crea la BD y las tablas si no existen.
GESTOR_MYSQL_ENABLED=true
GESTOR_MYSQL_HOST=127.0.0.1
GESTOR_MYSQL_PORT=3306
GESTOR_MYSQL_DB=colbeef_gestor
GESTOR_MYSQL_USER=gestor
GESTOR_MYSQL_PASSWORD="cambiar_mysql"
# Contraseña del dashboard /usabilidad.html (sin default débil en producción)
USABILITY_ADMIN_PASSWORD="cambiar_admin"

# PostgreSQL: use 127.0.0.1 si la BD está en esta máquina, o la IP del servidor SIRT
# POSTGRES_HOST=192.168.x.x

# Estado_Cavas: subproductos retenidos en cava sin fecha_salida.
SIRT_CAVA_LOOKBACK_DAYS=30

# Despachos_Cavas: salidas de cava con fecha_salida.
SIRT_SALIDAS_CAVA_LOOKBACK_DAYS=30
# programado = en cava + fecha_programacion_despacho (como ERP)
# erp = despacho_desposte · riel = solo fecha_salida física
SIRT_DESPACHOS_FUENTE=programado

# Decomisos (SAI): días hacia atrás desde la fecha del encabezado (automático en el programa).
SIRT_DECOMISO_LOOKBACK_DAYS=7
