POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sirt
POSTGRES_USER=acceso
POSTGRES_PASSWORD=cambiar
# Solo lectura: el servidor no ejecuta INSERT/UPDATE/DELETE
POSTGRES_READ_ONLY=true
SERVER_PORT=3001

# Decomisos (sai.decomiso): si al elegir UN solo día en «SIRT día» no hay filas pero el día anterior sí,
# ampliar el rango hacia atrás (típico: estado con fecha D, decomisos con fecha_registro D-1).
# 0 = solo el día elegido (comportamiento antiguo).
SIRT_DECOMISO_EXTRA_DAYS_BEFORE=1
SIRT_DECOMISO_EXTRA_DAYS_AFTER=0
