{
  "name": "colbeef-sirt-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "probe": "node scripts/probe-db.mjs",
    "search-tables": "node scripts/search-tables.mjs",
    "view-def": "node scripts/print-view-definition.mjs",
    "test:decomiso-cruce": "node scripts/test-decomiso-cruce.mjs",
    "test:planilla-opl": "node scripts/test-planilla-opl.mjs",
    "test:crudas-despacho": "node scripts/test-crudas-despacho.mjs",
    "test:despacho-kpi-freeze": "node scripts/test-despacho-kpi-freeze.mjs",
    "test:opl-juego": "node scripts/test-opl-juego.mjs",
    "analyze:data-excel": "node scripts/analyze-data-excel.mjs",
    "probe:decomiso-dates": "node scripts/probe-decomiso-dates.mjs",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite --config client/vite.config.js --host 0.0.0.0",
    "dev:lan": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build --config client/vite.config.js",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "start:lan": "npm run build && cross-env NODE_ENV=production node server/index.js",
    "service:install": "node scripts/service-install.cjs",
    "service:uninstall": "node scripts/service-uninstall.cjs",
    "mysql:init": "node scripts/mysql-init.mjs"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "html2canvas": "^1.4.1",
    "multer": "^2.1.1",
    "mysql2": "^3.14.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "node-windows": "^1.0.0-beta.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8",
    "xlsx": "^0.18.5"
  }
}
